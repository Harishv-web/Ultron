# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit your real keys/secrets.

# Required for real AI chat replies and image generation. Without this,
# chat falls back to canned local responses and image generation is
# disabled outright.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Required for the Google Calendar / Gmail integration. Create credentials
# at https://console.cloud.google.com/apis/credentials (OAuth client ID,
# type "Web application"). Without these, the Google connect button just
# shows "not configured".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the redirect URI registered on that OAuth client exactly.
GOOGLE_REDIRECT_URI=http://localhost:4000/api/integrations/google/callback

# Port the Express backend (server.js) listens on.
PORT=4000

# Where the backend should send the browser after a Google login completes.
# This must be wherever the FRONTEND is actually running — not the backend.
FRONTEND_URL=http://localhost:3000

# Base URL the React frontend uses to reach the backend.
# - Local dev on the same machine: http://localhost:4000
# - Testing on a phone/Android build: use your computer's LAN IP,
#   e.g. http://192.168.1.23:4000 (localhost on the phone means the
#   phone itself, not your dev machine)
# - Production: your deployed backend's public URL
VITE_API_URL=http://localhost:4000
